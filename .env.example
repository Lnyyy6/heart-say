# ===== 基础 =====
APP_ENV=dev
API_PORT=8010
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== 生成模型 =====
# offline: 无需 GPU/API，使用本地共情应答编排器（演示与 CI 默认）
# openai_compatible: 连接 vLLM / DashScope / DeepSeek 等 OpenAI 兼容服务
LLM_BACKEND=offline
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen2.5-7B-Instruct-AWQ
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=600
LLM_TIMEOUT=60

# 本地 Transformers（MPS/CPU；用于没有 CUDA 时评估 SFT adapter）
TRANSFORMERS_MODEL_PATH=Qwen/Qwen2.5-1.5B-Instruct
TRANSFORMERS_ADAPTER_PATH=outputs/sft-qwen1.5b
TRANSFORMERS_DEVICE=auto
TRANSFORMERS_MAX_NEW_TOKENS=260

# ===== 评测 judge =====
# heuristic: 离线规则评分（默认）；llm: 调用 OpenAI 兼容模型做 LLM-as-judge
JUDGE_BACKEND=heuristic
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=

# ===== RAG =====
# hash: 离线特征哈希向量（零下载、可复现）；bge-m3: 需安装 embeddings 依赖
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=BAAI/bge-m3
# auto: 有 MPS 时用 MPS；也可填 cpu / cuda
EMBEDDING_DEVICE=auto
RERANKER_BACKEND=heuristic
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# auto: 有 MPS 时用 MPS；也可填 cpu / cuda
RERANKER_DEVICE=auto
# 留空则使用嵌入式 Qdrant（data/qdrant）；Docker 中填 http://qdrant:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=heart_say_kb
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_FINAL=4

# ===== 会话记忆 =====
# 留空使用本地 JSON 会话存储；Docker 中填 redis://redis:6379/0
REDIS_URL=
SESSION_DIR=data/sessions
MAX_HISTORY_TURNS=8

# ===== 安全 =====
ENABLE_OUTPUT_GUARD=true
CRISIS_HOTLINE=12356

# ===== 前端 =====
NEXT_PUBLIC_API_BASE=http://localhost:8010
