# 心语 API 镜像。模型服务（vLLM）默认由独立容器/外部 GPU 提供。
FROM python:3.12-slim

WORKDIR /srv/heart-say

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/srv/heart-say/src

COPY pyproject.toml ./
RUN pip install --no-cache-dir "fastapi>=0.115" "uvicorn[standard]>=0.30" \
    "pydantic>=2.8" "pydantic-settings>=2.4" "qdrant-client>=1.12,<1.13" "numpy>=1.26" \
    "rank-bm25>=0.2.2" "jieba>=0.42.1" "httpx>=0.27" "python-dotenv>=1.0" \
    "pyyaml>=6.0" "langgraph>=0.2.50" "redis>=5.0" "sse-starlette>=2.1"

COPY src ./src
COPY app ./app
COPY data ./data

EXPOSE 8010
CMD ["uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8010"]